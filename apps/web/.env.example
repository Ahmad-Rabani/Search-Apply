# Copy to apps/web/.env after Google AdSense approval

# Publisher ID looks like: ca-pub-xxxxxxxxxxxxxxxx
VITE_ADSENSE_CLIENT=

# Create ad units in AdSense → Ads → By ad unit, paste slot IDs:
VITE_ADSENSE_SLOT_HEADER=
VITE_ADSENSE_SLOT_INFEED=
VITE_ADSENSE_SLOT_SIDEBAR=
VITE_ADSENSE_SLOT_FOOTER=

# Shown on Contact / Privacy pages
VITE_CONTACT_EMAIL=your-email@example.com
