# Copy to apps/api/.env

PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/search-and-apply
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173

# Preferred (free tier): Google Gemini
GEMINI_API_KEY=your-gemini-key-here
# GEMINI_MODEL=gemini-2.5-flash

# Optional fallback: Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# CLAUDE_MODEL=claude-sonnet-4-20250514

# Optional: Adzuna (Indeed-like aggregated jobs) — free at https://developer.adzuna.com/
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
